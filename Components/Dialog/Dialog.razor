@using Cardapio.Entities
@using Cardapio.Services
@using Cardapio.Components.PlusMinusButton
@inject CartService CartService
@inject DrawerService DrawerService
@inject NavigationManager Navigation
@inject ScreenSizeService ScreenSize

<MudDialog Class="dialog">
    <TitleContent></TitleContent>
    <DialogContent>
        <MudContainer Class="dialog-container pa-0">
            @if (ScreenSize.GetWidth() > 768)
            {
                <MudImage Class="dialog-img pa-2" Src="@produto.ImageUrl"></MudImage>
            }
            <MudContainer Class="dialog-title-container">
                <MudText Class="dialog-title">@produto.Name?.ToUpper()</MudText>
                <MudButton OnClick="DialogCancel" Class="dialog-close-button pa-0">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="dialog-close-button-svg">
                        <path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" />
                    </svg>
                </MudButton>
            </MudContainer>
            <MudContainer Class="content-container pa-0">
                <MudText Class="dialog-product-description py-2">@produto.Description</MudText>
                <MudContainer Class="pa-0">
                    <MudContainer Class="pa-0">
                        @if (ScreenSize.GetWidth() <= 768)
                        {
                            <MudImage Class="dialog-img pa-2" Src="@produto.ImageUrl"></MudImage>
                        }
                        @if (produto.Extras != null && produto.Extras.Any())
                        {
                            @foreach (var extra in produto.Extras)
                            {
                                <MudContainer Class="dialog-extra-header">
                                    <MudContainer Class="pa-0" Style="display: flex; flex-direction: column;">
                                        <MudText Style="font-weight:500;">@extra.Name</MudText>
                                        <MudText Class="dialog-extra-header-subtext">@extra.GetSubtext()</MudText>
                                    </MudContainer>
                                    @if (extra.Required)
                                    {
                                        <MudText Style="" Class="extra-minitag">OBRIGATÓRIO</MudText>
                                    }
                                </MudContainer>

                                if (extra.Options != null && extra.Options.Any())
                                {
                                    @foreach (var option in extra.Options)
                                    {
                                        <MudContainer class="py-4 extra-option">
                                            <MudContainer Style="flex: 1;" Class="pa-0 extra-description">
                                                <MudText Class="extra-option-name">
                                                    @option.Name @if (option.Price > 0)
                                                    {
                                                        @(" + " + option.Price.ToString("C"))
                                                    }
                                                </MudText>
                                                @if (!String.IsNullOrEmpty(option.Description))
                                                {
                                                    <MudText Class="extra-option-description">@option.Description</MudText>
                                                }
                                            </MudContainer>
                                            <MudContainer Class="pa-0 extra-img-container">
                                                <MudImage Class="extra-img" Src="@option.Url"></MudImage>
                                            </MudContainer>
                                            @if (extra.Quantity > 1)
                                            {
                                                <PlusMinusButton CounterStartValue="@(extrasSelectedOptions
                                                    .First(s => s.Extra.Equals(extra))
                                                    .SelectedOptions
                                                    .Count(o => o.Equals(option)))"
                                                    PartialHidden=true
                                                    OnCounterChange="count => HandleExtraQuantity(extra, option, count)"
                                                    AvailableSelections="@GetExtraAvailableSelections(extra)"></PlusMinusButton>
                                            }
                                            else
                                            {
                                                <input style="margin: 0px 8px 0px 8px; height: 24px; width: 24px;"
                                                       type="radio"
                                                       name="@extra.Name"
                                                       value="@option.Name"
                                                       checked="@(extrasSelectedOptions
                                                        .First(s=> s.Extra.Equals(extra))
                                                        .SelectedOptions
                                                        .Any(o => o.Equals(option)))"
                                                       @onchange="(e)=> HandleRadioSelector(extra, option)" />
                                            }
                                        </MudContainer>
                                    }
                                }
                            }
                        }
                    </MudContainer>
                </MudContainer>
                <MudContainer Class="pa-0 my-4 px-10 comment-container">
                    <MudContainer Class="pa-0 mb-2" Style="display:flex; justify-content:space-between;">
                        <MudText Class="comment-container-lable">Algum comentário?</MudText>
                        <MudText Class="comment-container-counter">@($"{Comment.Length} / 140")</MudText>
                    </MudContainer>
                    <textarea @bind="Comment" @bind:event="oninput" placeholder="Ex: tirar a cebola, maionese à parte etc." maxlength="140" class="comment-textfield"></textarea>
                </MudContainer>
            </MudContainer>
            <MudContainer Class="dialog-actions pa-3">
                <PlusMinusButton OnCounterChange="@UpdateProductQuantity"
                                 CounterMinValeu="1"
                                 CounterStartValue=@(Item != null ? Item.Quantity : 1)>
                </PlusMinusButton>
                <MudButton Class=@($"dialog-addToCart-button px-5 {(!AreRequiredExtrasSelected() ? "dialog-addToCart-button-disable" : "")}")
                           Disabled="!AreRequiredExtrasSelected()"
                           OnClick="@AddToCart">
                    <MudText Style="color: #fff; font-size: 0.9rem;">@(Item != null ? "Atualizar" : "Adicionar")</MudText>
                    <MudText Style="color: #fff; font-size: 0.9rem;">@totalPrice.ToString("C")</MudText>
                </MudButton>
            </MudContainer>
        </MudContainer>
    </DialogContent>
</MudDialog>

<style>
    .dialog {
        min-height: 400px;
        min-width: 400px;
        max-width: 1200px;
        max-height: 600px;
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        margin-left: 16px;
        margin-right: 16px;
    }

    .dialog-title-container {
        grid-row-start: 1;
        grid-row-end: 1;
        grid-column-start: 2;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dialog-title {
        font-size: 0.75rem;
        font-weight: 500;
    }

    .dialog-img {
        grid-row: 1 / span 3;
        max-width: 500px;
        max-height: 500px;
        height: 100%;
        width: 100%;
        align-self: center;
        justify-self: center;
        object-fit: contain !important;
    }

    .dialog-container {
        flex: 1;
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 40px 1fr 80px;
    }

    .extra-option-name {
        flex: 1;
        font-weight: 300;
    }

    .extra-option-description {
        font-size: 0.9rem;
        color: rgb(113, 113, 113);
        font-weight: 300;
    }

    .extra-img {
        max-height: 75px;
        max-width: 85px;
        object-fit: contain !important;
    }

    @@media (max-width: 768px) {
        .dialog-container {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto 1fr auto;
            padding-left: 20px !important;
            padding-right: 20px !important;
            overflow-y: scroll;
        }

        .dialog-img {
            grid-column: 1;
            grid-row: 2;
            max-width: 100%;
            max-height: 250px;
            padding-top: 32px !important;
        }

        .dialog-title-container {
            grid-column: 1;
            grid-row: 1;
            height: 40px;
        }

        .content-container {
            grid-column: 1 !important;
            grid-row: 3 !important;
        }

        .dialog-actions {
            grid-column: 1 !important;
            grid-row: 4 !important;
            display: flex;
        }

        .dialog {
            max-width: 100vh;
            max-height: 100vh;
            margin-left: 0px;
            margin-right: 0px;
        }

        .extra-option {
            padding-right: 12px !important;
            padding-left: 12px !important;
        }

        .extra-option-name {
            font-size: .8rem;
        }

        .extra-option-description {
            font-size: 0.6rem;
        }

        .extra-img {
            max-height: 75px;
            max-width: 70px;
        }
    }

    .dialog-close-button {
        position: absolute;
        right: 0;
    }

    .dialog-close-button-svg {
        width: 32px;
        height: 32px;
    }

    .content-container {
        min-height: 0;
        min-width: 0;
        grid-column: 2;
        grid-row: 2;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .dialog-product-description {
        font-size: 1rem;
        font-weight: 300;
        color: #717171;
    }

    .dialog-actions {
        grid-column: 2;
        grid-row: 3;
        display: flex;
        gap: 16px;
        justify-content: end;
        align-items: center;
        border-top: 2px solid rgb(245, 240, 235);
    }

    .mud-dialog-content {
        overflow-x: hidden;
        flex: 1;
        display: flex;
        flex-direction: column;
        padding-left: 0px !important;
        padding-right: 0px !important;
        margin: 0px !important;
    }

    .mud-dialog-title {
        display: none;
    }

    .extra-option {
        display: flex;
        align-items: center;
        min-height: 150px;
        padding-right: 40px;
        padding-left: 40px;
    }

    .extra-description {
        max-width: 280px;
    }

    .extra-img-container {
        height: 75px;
        width: 85px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .dialog-extra-header {
        max-height: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        background-color: rgb(242, 242, 242);
        font-size: 1rem;
    }

    .dialog-extra-header-subtext {
        font-size: 0.875rem;
        color: rgb(113, 113, 113);
    }

    .extra-minitag {
        font-size: 0.5625rem;
        background-color: #717171;
        width: 72px;
        max-height: 18px;
        padding: 2px 6px 2px 6px;
        border-radius: 3px 3px;
        color: #fff;
    }

    .dialog-addToCart-button {
        display: felx;
        height: 50px;
        max-width: 240px;
        width: 100%;
        background-color: rgb(234, 29, 44);
        justify-content: space-between;
        align-items: center;
    }

        .dialog-addToCart-button:hover {
            background-color: rgb(238, 76, 88);
        }

    .dialog-addToCart-button-disable {
        background-color: rgb(243, 122, 131) !important;
    }

    .mud-dialog-container {
        padding-top: 24pxt;
    }

    .scroll-locked {
        padding-right: 0px !important;
        overflow: hidden;
    }

    .comment-textfield {
        height: 105px;
        width: 100%;
        padding: 20px;
        box-sizing: border-box;
        resize: none;
        border: 1px solid #dcdcdc;
        border-radius: 4px;
    }

    .comment-container-lable {
        rgb(113, 113, 113);
        font-weight: 500;
    }

    .comment-container-counter {
        color: #a6a6a6;
        font-weight: 100;
        font-size: .875rem;
    }

</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Produto produto { get; set; } = new Produto();

    [Parameter]
    public MenuSection menuSection { get; set; } = new MenuSection();

    [Parameter]
    public CartItem? Item { get; set; }

    private void DialogSubmit() => MudDialog.Close(DialogResult.Ok(true));
    private void DialogCancel() => MudDialog.Cancel();

    private List<ExtraSelectedOptions> extrasSelectedOptions = new();
    private Decimal totalPrice;
    private int ProductQuantity = 1;
    private string Comment { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        if (Item?.Extras != null && Item.Extras.Any())
        {
            extrasSelectedOptions = Item?.Extras;
            Comment = Item?.Comment;
            ProductQuantity = Item.Quantity;
            UpdateTotalPrice();
        }
        else
        {
            extrasSelectedOptions = produto.Extras
                .Select(extra => new ExtraSelectedOptions(extra))
                .ToList();

            totalPrice = produto.Price;
        }
    }

    private void HandleExtraQuantity(Extra extra, ExtrasOption option, int counter)
    {
        var selection = extrasSelectedOptions.First(s => s.Extra.Equals(extra));
        selection.SelectedOptions.RemoveAll(o => o.Equals(option));

        for (int i = 0; i < counter; i++)
        {
            if (selection.SelectedOptions.Count < extra.Quantity)
                selection.SelectedOptions.Add(option);
        }

        UpdateTotalPrice();
        StateHasChanged();
    }

    private void HandleRadioSelector(Extra extra, ExtrasOption option)
    {
        var selection = extrasSelectedOptions.First(s => s.Extra.Equals(extra));
        selection.SelectedOptions.Clear();
        selection.AddOption(option);

        UpdateTotalPrice();
        StateHasChanged();
    }

    private void UpdateTotalPrice()
    {
        totalPrice = (produto.Price + extrasSelectedOptions.Sum(s => s.GetTotalPrice())) * ProductQuantity;
        StateHasChanged();
    }

    private void UpdateProductQuantity(int counter)
    {
        ProductQuantity = counter;
        UpdateTotalPrice();
    }

    private int GetExtraAvailableSelections(Extra extra)
    {
        return extra.Quantity - extrasSelectedOptions.First(s => s.Extra.Equals(extra)).SelectedOptions.Count();
    }

    private bool AreRequiredExtrasSelected()
    {
        return extrasSelectedOptions.All(s =>
        {
            if (!s.Extra.Required)
                return true;

            return s.SelectedOptions.Any();
        });
    }

    void AddToCart()
    {
        var newItem = new CartItem
            {
                Product = produto,
                Price = totalPrice,
                Quantity = ProductQuantity,
                Extras = extrasSelectedOptions,
                MenuSection = menuSection,
                Comment = Comment
            };

        if (Item != null)
        {
            CartService.EditItem(newItem, Item);
            DialogSubmit();
        }
        else
        {
            CartService.AddItem(newItem);
            DialogSubmit();
        }

        if (!Navigation.Uri.EndsWith("/Pagamento"))
        {
            DrawerService.Open();
        }
    }
}
