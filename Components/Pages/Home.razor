@page "/"
@using MudBlazor
@using Dialog
@using Cardapio.Entities
@using Cardapio.Services
@inject IDialogService DialogService
@rendermode InteractiveServer
@inject ScreenSizeService ScreenSize



<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
    @if(Sections == null)
    {
        <MudItem xs="12">
            <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large"></MudProgressCircular>
            <MudText Class="ml-4">Carregando produtos...</MudText>
        </MudItem>
    }
    else if (!Sections.Any())
    {
        <MudItem xs="12">
            <MudText Typo="Typo.h6">Nenhum produto encontrado.</MudText>
        </MudItem>
    }
    else
    {
        foreach(var menuSection in Sections)
        {
            <MudItem xs="12">
                <MudText Class="mb-6 pt-10 menu-section-title" Typo="Typo.h3">
                    @menuSection.SectionName
                </MudText>
            </MudItem>
            <MudGrid>
                @if (menuSection.Products == null)
                {
                    <MudItem xs="12">
                        <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large"></MudProgressCircular>
                        <MudText Class="ml-4">Carregando produtos...</MudText>
                    </MudItem>
                }
                else if (!menuSection.Products.Any())
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6">Nenhum produto encontrado.</MudText>
                    </MudItem>
                }
                else
                {
                    @foreach (var product in menuSection.Products)
                    {
                        <MudItem xs="12" sm="12" md="6">
                            <MudCard @onclick="@((e) => OpenDialogAsync(product, menuSection))" Elevation="0" Class="card">
                                <MudCardContent Class="pa-4">
                                    <MudStack Row Class="gap-xs-0 gap-sm-1 gap-sm-3" style="height: 100%">
                                        <MudContainer Class="pa-0 d-flex flex-column">
                                            <MudContainer class="pa-0 flex-grow-1">
                                                <MudText Typo="@Typo.h5" Class="product-name">@product.Name</MudText>
                                                <MudText Typo="@Typo.body2" Class="multiline-ellipsis product-description">@product.Description</MudText>
                                            </MudContainer>
                                            <MudText Class="product-price" Typo="@Typo.subtitle1">@product.Price.ToString("C")</MudText>
                                        </MudContainer>
                                        <MudImage Src=@product.ImageUrl Class="product-img"></MudImage>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                }
            </MudGrid>
        }
    }

</MudContainer>


<style>
    .card {
    height: 205px;
    width: 100%;
    border: solid 1px rgb(242, 242, 242);
    box-shadow: 0 1px 4px rgba(0, 0, 0, .05);
    }

    .product-img {
    max-width: 180px;
    max-height: 180px;
    object-fit: contain !important;
    width: auto;
    height: auto;
    display: block;
    }

    .product-name {
    font-size:1.125rem;
    font-weight: 400;
    margin-bottom: 18px
    }

    .product-description {
    font-size: 0.830rem;
    font-weight: 300;
    color: #717171;
    }

    .product-price {
    font-size: 1rem;
    font-weight: 400;
    }

    .menu-section-title {
    font-size:1.5rem;
    font-weight: 500;
    letter-spacing: -1px;
    }

    #no-wasm-warning {
    display: none;
    color: #808080;
    padding: 2rem;
    text-align: center;
    font-weight: bold;
    }

    .multiline-ellipsis {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    display: box;
    box-orient: vertical;
    line-clamp: 2;
    overflow: hidden;
    }

    .rounded-default {
    border-radius: 12px !important;
    -webkit-border-radius: 12px !important; /* Chrome, Safari */
    -moz-border-radius: 12px !important; /* Firefox antigo */
    }

</style>

