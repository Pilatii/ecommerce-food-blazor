    else
    {
        <MudContainer Class="pa-0 px-8 cart-content">
            <CartItemsDisplay></CartItemsDisplay>
        </MudContainer>
        <MudContainer Class="pa-0 py-4 px-8 cart-fixed-footer">
            <MudContainer Class="pa-0 pb-2 cart-fixed-footer-info">
                <MudText>Total</MudText>
                <MudText>@((CartService.GetTotalPrice() + 9.99m).ToString("C"))</MudText>
            </MudContainer>
            <button @onclick="GoToPayment" Class="cart-pay-button">Escolher forma de pagamento</button>
        </MudContainer>
    }
</MudContainer>

<style>

    .cart-drawer {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .cart-content {
        flex: 1;
        overflow: hidden;
        overflow-y: scroll;
    }

    .drawer-close-button {
        min-height: 32px !important;
        min-width: 32px !important;
        max-height: 32px !important;
        max-width: 32px !important
    }

    .cart-section-name {
        font-size: .9rem;
        font-weight: 500;
        padding-bottom: 10px;
        color: #3f3e3e;
    }

    .cart-footer-info {
        border-top: solid 1px rgb(220, 220, 220);
    }

    .cart-footer-info-text {
        display: flex;
        justify-content: space-between
    }

        .cart-footer-info-text p {
            color: #717171;
            font-size: .875rem;
            font-weight: 300;
        }

    .cart-fixed-footer-info {
        display: flex;
        justify-content: space-between;
    }

        .cart-fixed-footer-info p {
            color: #3f3e3e;
            font-size: 1.125rem;
            font-weight: 500;
        }

    .cart-pay-button {
        height: 50px;
        width: 100%;
        background-color: rgb(234, 29, 44);
        color: #FFF;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 500;
    }

        .cart-pay-button:hover {
            background-color: rgb(238, 76, 88)
        }

    .empty-cart {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .empty-cart-svg {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .empty-cart-text-large {
        font-weight: 500;
        font-size: 1rem;
    }

    .empty-cart-text-small {
        font-weight: 400;
        font-size: .875rem;
        color: #717171;
    }

</style>

@code {

    protected override void OnInitialized()
    {
        base.OnInitialized();
        CartService.OnChange += StateHasChanged;
    }

    private Task OpenDialogAsync(Produto produto, MenuSection menuSection, CartItem item)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var parameters = new DialogParameters<Produto> { { "produto", produto }, { "MenuSection", menuSection }, { "Item", item } };

        return DialogService.ShowAsync<Dialog>("Simple Dialog", parameters, options);
    }

    private void GoToPayment()
    {
        DrawerService.Close();
        Navigation.NavigateTo("/Pagamento");
    }
}
